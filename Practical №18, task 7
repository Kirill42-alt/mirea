import java.util.Scanner;

/**
 * Пример демонстрации прохождения исключения через цепочку вызовов.
 */
public class ThrowsDemo {

    /**
     * Метод getKey() запрашивает у пользователя ввод ключа
     * и передаёт его дальше, пробрасывая исключение выше по стеку вызовов.
     */
    public void getKey() throws Exception {
        Scanner myScanner = new Scanner(System.in);
        System.out.print("Введите ключ: ");
        String key = myScanner.next();
        printDetails(key); // Пробрасываем исключение из printDetails(), если оно возникло.
        myScanner.close();
    }

    /**
     * Метод printDetails() вызывает getDetails() и пробрасывает исключение дальше.
     */
    public void printDetails(String key) throws Exception {
        String message = getDetails(key); // Может выбросить Exception.
        System.out.println(message);
    }

    /**
     * Метод getDetails() проверяет ключ.
     * Если ключ - пустая строка, выбрасывает исключение.
     */
    private String getDetails(String key) throws Exception {
        if (key.equals("")) {
            throw new Exception("Key set to empty string");
        }
        return "data for " + key;
    }

    /**
     * Точка входа в программу.
     * Здесь мы вызываем метод getKey() и обрабатываем возможное исключение.
     */
    public static void main(String[] args) {
        ThrowsDemo demo = new ThrowsDemo();

        try {
            demo.getKey(); // Пробрасывает Exception вверх.
        } catch (Exception e) {
            System.out.println("Исключение обработано в main(): " + e.getMessage());
        }

        System.out.println("Программа завершена корректно.");
    }
}
