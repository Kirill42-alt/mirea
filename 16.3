import javax.swing.*;
import java.awt.*;

public class Main {

    public static void main(String[] args) {
        JPanel panel = new JPanel();

        JFrame frame = new JFrame("Password application");
        frame.setSize(350, 150);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setResizable(false); // Запрещаем изменение размера окна пользователем

        JLabel label = new JLabel("Service:");
        panel.add(label);
        JTextField inputField1 = new JTextField(20);
        panel.add(inputField1);

        JLabel label2 = new JLabel("User name:");
        panel.add(label2);
        JTextField inputField2 = new JTextField(20);
        panel.add(inputField2);

        JLabel label3 = new JLabel("Password:");
        panel.add(label3, BorderLayout.NORTH);
        JTextField inputField3 = new JTextField(20);
        panel.add(inputField3);

        frame.getContentPane().add(panel);
        frame.setVisible(true);
    }
}
