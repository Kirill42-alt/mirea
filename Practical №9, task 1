import java.util.Arrays;
import java.util.Random;

// Класс Student
class Student {
    private int iDNumber;
    private String name;

    // Конструктор
    public Student(int iDNumber, String name) {
        this.iDNumber = iDNumber;
        this.name = name;
    }

    // Геттер для iDNumber
    public int getIDNumber() {
        return iDNumber;
    }

    @Override
    public String toString() {
        return "Student { ID: " + iDNumber + ", Name: " + name + " }";
    }
}

// Класс для тестирования и сортировки студентов
public class StudentTest {
    public static void main(String[] args) {
        Random random = new Random();
        Student[] students = new Student[5];

        // Заполнение массива случайными студентами
        for (int i = 0; i < students.length; i++) {
            students[i] = new Student(random.nextInt(100) + 1, "Student" + (i + 1));
        }

        // Вывод исходного массива
        System.out.println("Исходный массив студентов:");
        printArray(students);

        // Сортировка вставками по iDNumber
        insertionSort(students);

        // Вывод отсортированного массива
        System.out.println("\nОтсортированный массив студентов:");
        printArray(students);
    }

    // Метод сортировки вставками
    public static void insertionSort(Student[] array) {
        for (int i = 1; i < array.length; i++) {
            Student key = array[i];
            int j = i - 1;

            while (j >= 0 && array[j].getIDNumber() > key.getIDNumber()) {
                array[j + 1] = array[j];
                j--;
            }
            array[j + 1] = key;
        }
    }

    // Метод вывода массива
    public static void printArray(Student[] array) {
        for (Student student : array) {
            System.out.println(student);
        }
    }
}
