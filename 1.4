import java.util.Scanner;

public class Main {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Введите размер массива: ");
        int size = scanner.nextInt();

        int[] numbers = new int[size];

        System.out.println("Введите элементы массива:");
        int i = 0;
        do {
            System.out.print("Элемент " + (i + 1) + ": ");
            numbers[i] = scanner.nextInt();
            i++;
        } while (i < size);

        // Сумма элементов с помощью цикла do while
        int sumDoWhile = 0;
        i = 0;
        do {
            sumDoWhile += numbers[i];
            i++;
        } while (i < size);

        // Сумма элементов с помощью цикла while
        int sumWhile = 0;
        i = 0;
        while (i < size) {
            sumWhile += numbers[i];
            i++;
        }

        // Поиск максимального и минимального элементов
        int max = numbers[0];
        int min = numbers[0];
        for (i = 1; i < size; i++) {
            if (numbers[i] > max) {
                max = numbers[i];
            }
            if (numbers[i] < min) {
                min = numbers[i];
            }
        }

        // Вывод результатов
        System.out.println("Сумма элементов массива (do while): " + sumDoWhile);
        System.out.println("Сумма элементов массива (while): " + sumWhile);
        System.out.println("Максимальный элемент массива: " + max);
        System.out.println("Минимальный элемент массива: " + min);
    }
}
