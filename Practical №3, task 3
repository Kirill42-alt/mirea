import java.util.Random; // Для использования класса Random

public class Main {

    public static void main(String[] args) {
        int size = 4; // Размер массива
        int[] array = new int[size]; // Создаем массив целых чисел

        Random rand = new Random(); // Создаем объект для генерации случайных чисел

        // Генерация случайных чисел в диапазоне от 10 до 99
        for (int i = 0; i < size; i++) {
            array[i] = rand.nextInt(90) + 10; // Случайное число от 10 до 99
        }

        // Выводим массив на экран
        System.out.print("Массив: ");
        for (int num : array) {
            System.out.print(num + " "); // Выводим все элементы массива
        }
        System.out.println();

        // Проверка, является ли массив строго возрастающим
        boolean isStrictlyIncreasing = true;
        for (int i = 1; i < size; i++) {
            if (array[i] <= array[i - 1]) {
                isStrictlyIncreasing = false; // Если элемент не больше предыдущего, последовательность не строго возрастающая
                break;
            }
        }

        // Выводим сообщение о том, является ли массив строго возрастающим
        if (isStrictlyIncreasing) {
            System.out.println("Массив является строго возрастающей последовательностью.");
        } else {
            System.out.println("Массив не является строго возрастающей последовательностью.");
        }
    }
}
