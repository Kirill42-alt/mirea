from tkinter import *
import tkinter as tk
import requests
from tkhtmlview import HTMLLabel
import tkinter.messagebox
from PIL import ImageTk, Image
import xml.etree.ElementTree as APIcentral


def bitcoin():
    request = requests.get('https://api.coinbase.com/v2/prices/spot?currency=USD')
    data = request.json()
    result = data['data']['amount']
    return result


apiUSArequests = float(APIcentral.fromstring(requests.get('https://www.cbr.ru/scripts/XML_daily.asp').text).find
                       ("./Valute[CharCode='USD']/Value").text.replace(",", "."))


def perform():
    value = convertedStart.get()

    if value != "":
        request = requests.get('https://api.coinbase.com/v2/prices/spot?currency=USD')
        data = request.json()
        score = data['data']['amount']
        result = float(value)/apiUSArequests/float(score)
        payBitcoin.configure(text=result, fg="#000", font=("Sans-serif", 14, 'bold'))
        payBitcoin.place(x=-38, y=300)
    else:
        payBitcoin.configure(text="I can't count if there are no numbers :P", fg="red", font=("Sans-serif", 10, 'bold'))
        payBitcoin.place(x=40, y=300)


def validate(val):
    return val == "" or val.isnumeric()


def about():
    tk.messagebox.showinfo("About the program",
                           "The program converts the Russian currency (ruble) into Bitcoin. The program "
                           "automatically receives the current rates of cryptocurrency and the US dollar "
                           "when executing the program based on "
                           "requests to the settlement exchange and the Central Bank of the "
                           "Russian Federation, therefore, a network connection is "
                           "required for the program to work.")


def real(block):
    block.selection_range(0, END)


root = tk.Tk()
root.title("Converter Bitcoin with API")
root.resizable(width=False, height=False)
root.geometry("370x513")
icon = tk.PhotoImage(file="bitcoin-ico16.png")
